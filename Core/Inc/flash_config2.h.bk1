//flash_config.h

#pragma once
#include "stm32f1xx_hal.h"

/* Ostatnia strona Flash STM32F103C8T6 (64KB) */
#define FLASH_CONFIG_ADDR    0x0800FC00UL
#define FLASH_MAGIC          0xCAFE1234UL

typedef struct {
    uint32_t  magic;          /* Walidacja — musi być == FLASH_MAGIC    */
    float     offset_lufy;    /* Dane z kalibracji kąta lufy            */
    float     offset_obrotu;  /* Dane z kalibracji obrotu               */
    float     pozycja_home_x; /* Pozycja home po homingu                */
    float     pozycja_home_y;
    uint32_t  crc;            /* Prosta suma kontrolna                  */
} KalibracjaFlash;

HAL_StatusTypeDef flash_zapisz_kalibracje(const KalibracjaFlash *dane);
int               flash_wczytaj_kalibracje(KalibracjaFlash *dane);
int               flash_kalibracja_valid(void);
